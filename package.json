{
  "name": "nexora-ecommerce",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:frontend": "npm run dev --workspace nexora-frontend",
    "dev:backend": "npm run dev --workspace nexora-api",
    "build": "npm run build --workspace nexora-frontend",
    "start": "npm run start --workspace nexora-api",
    "seed": "npm run seed --workspace nexora-api",
    "test": "node --test"
  },
  "allowScripts": {
    "argon2@0.44.0": true
  }
}
